# Copy to .env and paste your key only in that ignored local file.
GEMINI_API_KEY=
TINK_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional additional upload of each recorded assessment's audio to Meta. Restart the app
# after changing the provider. Gemini assessment remains separately configured above.
TINK_TRANSCRIPTION_PROVIDER=local
MODEL_API_KEY=
